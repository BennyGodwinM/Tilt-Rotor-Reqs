            doc /* The nacelle tilt mechanism shall carry the limit load without detrimental deformation and the ultimate load without failure. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Primary structure per the strength requirement.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'TLT-017'> tiltMass : VehicleRequirement {
            doc /* The tilt actuator and mechanism, per side, shall have a mass not exceeding [TBD] kg. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Mass budget.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'TLT-018'> tiltPower : VehicleRequirement {
            doc /* Each tilt actuator shall draw no more than [TBD] W averaged over the mission profile. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Holding torque draws power and reduces endurance.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'TLT-019'> tiltEndStops : VehicleRequirement {
            doc /* Each nacelle shall have mechanical end stops at the limits of the tilt range of TLT-001. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Prevents over travel on actuator failure.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'TLT-020'> tiltCalibrate : VehicleRequirement {
            doc /* The flight controller shall verify nacelle angle against known end stop positions during preflight checks. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Catches sensor drift or slippage.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'TLT-021'> tiltLife : VehicleRequirement {
            doc /* The tilt mechanism shall complete at least [TBD] conversion cycles without maintenance. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets maintenance interval and testing wear.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'TLT-022'> conversionSchedule : VehicleRequirement {
            doc /* The flight controller shall schedule nacelle angle as a function of airspeed within the conversion corridor, to be defined. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Corridor definition is still open (VEH-4).";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'TLT-023'> conversionAbort : VehicleRequirement {
                doc /* The flight controller shall return the nacelles to the hover position when the conversion leaves the corridor. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Hover is the known safe state.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
            }
        }
    }

    package PayloadReqs {
        requirement <'PLD-001'> payloadSensor : VehicleRequirement {
            doc /* The nose gimbal shall carry one payload sensor that is replaceable by the operator without modifying the airframe or gimbal. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Replaces the fixed GoPro in VEH-1 with a swappable sensor; the GoPro becomes one supported payload.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
            requirement <'PLD-002'> mechInterface : VehicleRequirement {
                doc /* The gimbal payload interface shall define one mounting pattern, with dimensions and fastener type of [TBD], for every supported sensor. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "A single mount is what makes sensors swappable.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'PLD-003'> swapTime : VehicleRequirement {
                doc /* A trained operator shall exchange the payload sensor in no more than [TBD] minutes using only the tools listed in the maintenance manual. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Swaps must be quick enough for field use.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
            }
            requirement <'PLD-004'> elecInterface : VehicleRequirement {
                doc /* The gimbal payload interface shall provide regulated power at [TBD] V and no more than [TBD] W to the sensor. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sensors differ in supply needs; the limit protects the avionics bus.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'PLD-005'> dataInterface : VehicleRequirement {
                doc /* The gimbal payload interface shall provide a data connection of type [TBD] with a minimum throughput of [TBD] Mbit/s. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Higher-rate sensors need a defined data path.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'PLD-006'> sensorDetect : VehicleRequirement {
                    doc /* The flight controller shall identify the installed sensor type within [TBD] s of power-up. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Mass, size and settings depend on which sensor is fitted.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                    requirement <'PLD-007'> sensorProfile : VehicleRequirement {
                        doc /* The flight controller shall load a stored profile for the identified sensor containing its mass, center of gravity offset and power draw. */
                        attribute :>> basis = Basis::projectChoice;
                        attribute :>> rationale = "Static margin and endurance estimates depend on the sensor.";
                        attribute :>> phase = "CDR";
                        attribute :>> verifyBy = VerificationMethod::byDemonstration;
                        requirement <'PLD-008'> unknownSensor : VehicleRequirement {
                            doc /* The flight controller shall block takeoff when the installed sensor has no stored profile and no manual mass entry. */
                            attribute :>> basis = Basis::projectChoice;
                            attribute :>> rationale = "Unknown mass makes the static margin estimate unreliable.";
                            attribute :>> phase = "CDR";
                            attribute :>> verifyBy = VerificationMethod::byDemonstration;
                        }
                    }
                }
            }
            requirement <'PLD-009'> maxMass : VehicleRequirement {
                doc /* The gimbal shall support a payload sensor of mass up to [TBD] kg. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sets the gimbal and mount design load.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'PLD-010'> maxEnvelope : VehicleRequirement {
                    doc /* The gimbal shall support a payload sensor within an envelope of [TBD] mm by [TBD] mm by [TBD] mm. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Sets nose clearance and gimbal rotation space.";
                    attribute :>> phase = "PDR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
                requirement <'PLD-011'> massRange : VehicleRequirement {
                    doc /* The gimbal control shall tune to any sensor mass within the range in PLD-009 using the stored profile. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Pointing quality changes with payload inertia.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
            requirement <'PLD-021'> payloadRecord : VehicleRequirement {
                doc /* The aircraft shall record the sensor identifier in the flight log for each flight. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Links data to the sensor used.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'PLD-022'> payloadList : VehicleRequirement {
                doc /* The program shall maintain a list of supported sensors, each with a completed profile and a verification record. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Each supported sensor must have been checked for mass and clearance.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
        }
        requirement <'PLD-012'> payloadMassBudget : VehicleRequirement {
            doc /* The takeoff mass requirement shall be met with the heaviest supported payload sensor. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Part 107 mass limit applies for any sensor.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-013'> gimbalAxes : VehicleRequirement {
            doc /* The gimbal shall point the payload sensor in pitch over at least [TBD] deg and in yaw over at least [TBD] deg. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Pointing range defines the field of regard.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'PLD-014'> gimbalAccuracy : VehicleRequirement {
                doc /* The gimbal shall hold the commanded pointing angle within [TBD] deg during hover and cruise. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Pointing error degrades sensor data.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'PLD-015'> gimbalStabilize : VehicleRequirement {
                doc /* The gimbal shall isolate the sensor from aircraft angular motion to within [TBD] deg rms. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Image quality needs stabilization.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'PLD-016'> gimbalClear : VehicleRequirement {
            doc /* The gimbal and sensor shall not contact the rotors, airframe or ground in any gimbal position or any tilt position. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Prevents strikes during rotation and landing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'PLD-017'> gimbalPower : VehicleRequirement {
            doc /* The gimbal and payload sensor together shall draw no more than [TBD] W averaged over the mission. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Payload power reduces endurance.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-018'> gimbalCommandBoundary : VehicleRequirement {
            doc /* The gimbal yaw command shall be added to the boundary variables with a unit, range, latency and tolerance. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Closes the gimbal in the boundary definition of VEH-8.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'PLD-019'> payloadFault : VehicleRequirement {
            doc /* The flight controller shall continue flight when the payload sensor or gimbal fails. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Payload loss must not endanger the aircraft.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'PLD-020'> payloadRetain : VehicleRequirement {
            doc /* The sensor mount shall retain the sensor in all flight and landing load cases of the strength requirements. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "A released sensor is a hazard to people on the ground.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'FPV-001'> fpvCamera : VehicleRequirement {
            doc /* The vehicle shall carry a forward-looking FPV camera, separate from the payload sensor, that provides live video to the remote pilot. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pilot situational awareness, independent of what payload is fitted.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
            requirement <'FPV-002'> fpvFov : VehicleRequirement {
                doc /* The FPV camera shall have a horizontal field of view of at least [TBD] deg. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Pilot needs enough view to fly the aircraft.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'FPV-003'> fpvLatency : VehicleRequirement {
                doc /* The end-to-end FPV video latency from camera to pilot display shall not exceed [TBD] ms. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Latency limits how well the pilot can control by FPV.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FPV-004'> fpvResolution : VehicleRequirement {
                doc /* The FPV video shall have a resolution of at least [TBD] by [TBD] pixels at [TBD] frames per second. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sets image quality for the pilot.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FPV-005'> fpvView : VehicleRequirement {
                doc /* The FPV camera shall be mounted so that the nacelles, rotors and gimbal do not block more than [TBD] percent of its field of view. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "The aircraft must not hide the view ahead.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'FPV-006'> fpvDownlink : VehicleRequirement {
                doc /* The video link shall operate at the range of the visual line of sight limit with the margin of [TBD] dB. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Loss of video at the range limit is unacceptable.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FPV-008'> fpvPower : VehicleRequirement {
                doc /* The FPV camera and transmitter shall draw no more than [TBD] W. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Part of the avionics power budget.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FPV-009'> fpvOverlay : VehicleRequirement {
                doc /* The video display shall overlay airspeed, altitude, remaining energy, nacelle angle and static margin status. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Lets the pilot see key data while flying FPV.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
            }
            requirement <'FPV-010'> fpvLoss : VehicleRequirement {
                doc /* The flight controller shall indicate loss of the video link to the pilot within [TBD] s. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "The pilot must know when video is gone.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'FPV-007'> fpvNotSubstitute : VehicleRequirement {
            doc /* The remote pilot shall maintain visual line of sight with the aircraft while FPV video is in use. */
            attribute :>> basis = Basis::directive;
            attribute :>> rationale = "FPV does not replace visual line of sight under Part 107; a visual observer or the pilot's own sight remains required.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
    }

    package StabilityReqs {
        requirement <'STB-001'> staticMarginEstimate : VehicleRequirement {
            doc /* The flight controller shall estimate the longitudinal static margin, expressed as a fraction of mean aerodynamic chord, before takeoff and during flight. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pitch stability depends on center of gravity and neutral point, both of which change with payload and tilt.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'STB-002'> cgEstimate : VehicleRequirement {
                doc /* The flight controller shall estimate the aircraft center of gravity from the stored component masses and positions, including the battery position and the installed sensor profile. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Payload swaps and battery position move the center of gravity.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
                requirement <'STB-003'> cgAccuracy : VehicleRequirement {
                    doc /* The center of gravity estimate shall be accurate to within [TBD] percent of mean aerodynamic chord. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Estimate error is a direct error in static margin.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
                requirement <'STB-004'> batteryPosition : VehicleRequirement {
                    doc /* The aircraft shall detect the battery position in its tray or accept a position entered by the operator. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Battery is the largest movable mass.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
            requirement <'STB-005'> neutralPoint : VehicleRequirement {
                doc /* The flight controller shall estimate the neutral point from an aerodynamic model scheduled with nacelle tilt angle and airspeed. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Tilting rotors change the neutral point strongly during conversion.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
                requirement <'STB-006'> neutralPointAccuracy : VehicleRequirement {
                    doc /* The neutral point estimate shall be accurate to within [TBD] percent of mean aerodynamic chord. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Estimate error is a direct error in static margin.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
            requirement <'STB-007'> smInflight : VehicleRequirement {
                doc /* The flight controller shall refine the static margin estimate in flight from measured trim and pitch response. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Checks the model against the real aircraft.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'STB-008'> smUpdate : VehicleRequirement {
                    doc /* The static margin estimate shall be updated at least every [TBD] s during flight. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Static margin changes during conversion.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
            requirement <'STB-009'> smLimits : VehicleRequirement {
                doc /* The minimum and maximum acceptable static margins shall be defined for the hover, conversion and cruise modes as [TBD]. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Warnings need defined thresholds.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
                requirement <'STB-010'> smWarnPre : VehicleRequirement {
                    doc /* The flight controller shall inhibit takeoff when the estimated static margin is outside the limits of STB-009 for the planned configuration. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Prevents flying an unstable aircraft.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
                requirement <'STB-011'> smWarnCaution : VehicleRequirement {
                    doc /* The flight controller shall give the remote pilot a caution when the estimated static margin comes within [TBD] of a limit. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Early warning before the limit is reached.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
                requirement <'STB-012'> smWarnAlert : VehicleRequirement {
                    doc /* The flight controller shall give the remote pilot an alert within [TBD] s when the estimated static margin is outside a limit in flight. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "The pilot needs time to react.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                    requirement <'STB-013'> smAlertAction : VehicleRequirement {
                        doc /* The flight controller shall command the landing mode when an alert persists for more than [TBD] s. */
                        attribute :>> basis = Basis::placeholder;
                        attribute :>> rationale = "Gives the pilot time to act first, then lands.";
                        attribute :>> phase = "CDR";
                        attribute :>> verifyBy = VerificationMethod::byDemonstration;
                    }
                }
                requirement <'STB-022'> smStolLimits : VehicleRequirement {
                    doc /* The static margin limits shall be defined for each nacelle angle in the STOL range. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Partial tilt changes the neutral point.";
                    attribute :>> phase = "PDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
            }
            requirement <'STB-014'> smConfidence : VehicleRequirement {
                doc /* The flight controller shall report a confidence level with each static margin estimate. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "A poor estimate must not look like a good one.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'STB-020'> lowConfidenceCaution : VehicleRequirement {
                    doc /* The flight controller shall give a caution when the static margin confidence is low. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Low confidence must be visible.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
            requirement <'STB-015'> smConfirmBalance : VehicleRequirement {
                doc /* The operator shall be able to confirm the estimate by a ground balance check. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Ground check catches errors in stored masses.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
                requirement <'STB-021'> measuredCg : VehicleRequirement {
                    doc /* The flight controller shall accept a measured center of gravity as an input to the estimate. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Ground measurement overrides the stored model.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
            requirement <'STB-016'> smRecord : VehicleRequirement {
                doc /* The aircraft shall log the static margin estimate, its confidence and its inputs throughout every flight. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Supports review and model correction.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'STB-017'> smFlightTest : VehicleRequirement {
                doc /* The static margin estimate shall be compared with flight test results at [TBD] configurations before release. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Validates the estimator.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'STB-018'> smRateDisplay : VehicleRequirement {
                doc /* The ground station shall display static margin, its limits and its confidence to the remote pilot. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "The pilot needs to see the number.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
            }
        }
    }

    package OperationsReqs {
        requirement <'OPS-001'> opModes : VehicleRequirement {
            doc /* The vehicle shall operate in four takeoff and landing modes: CTOL, STOL, VTOL and C/VTOL. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pilot choice of mode per flight.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
            requirement <'OPS-002'> ctolDef : VehicleRequirement {
                doc /* CTOL shall mean takeoff and landing with the nacelles at a fixed forward angle of [TBD] deg and a ground roll. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Defines the term for the requirements below.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'OPS-005'> ctolGear : VehicleRequirement {
                    doc /* The vehicle shall have landing gear that supports the aircraft on the ground in CTOL mode. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Program owner chose landing gear for CTOL.";
                    attribute :>> phase = "PDR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                    requirement <'OPS-006'> ctolRunway : VehicleRequirement {
                        doc /* The takeoff ground roll in CTOL mode shall not exceed [TBD] m on [TBD] surface. */
                        attribute :>> basis = Basis::placeholder;
                        attribute :>> rationale = "Sets the runway the operator needs.";
                        attribute :>> phase = "CDR";
                        attribute :>> verifyBy = VerificationMethod::byTest;
                    }
                    requirement <'OPS-007'> ctolLandingRoll : VehicleRequirement {
                        doc /* The landing ground roll in CTOL mode shall not exceed [TBD] m on [TBD] surface. */
                        attribute :>> basis = Basis::placeholder;
                        attribute :>> rationale = "Sets the runway the operator needs.";
                        attribute :>> phase = "CDR";
                        attribute :>> verifyBy = VerificationMethod::byTest;
                    }
                    requirement <'OPS-023'> stolGearLoad : VehicleRequirement {
                        doc /* The landing gear shall carry the limit load of a STOL landing at a descent rate of [TBD] m/s and a forward speed of [TBD] kt without detrimental deformation. */
                        attribute :>> basis = Basis::placeholder;
                        attribute :>> rationale = "STOL landings are at higher speed than VTOL landings.";
                        attribute :>> phase = "CDR";
                        attribute :>> verifyBy = VerificationMethod::byAnalysis;
                    }
                }
                requirement <'OPS-008'> ctolClear : VehicleRequirement {
                    doc /* The rotors shall clear the ground by at least [TBD] mm in CTOL takeoff and landing attitudes. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Strike risk on rotation and flare.";
                    attribute :>> phase = "PDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
                requirement <'OPS-009'> ctolSpeeds : VehicleRequirement {
                    doc /* The rotation speed and approach speed for CTOL mode shall be determined by flight test and recorded in the flight manual. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Needed before CTOL flights are made.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
                requirement <'OPS-010'> ctolGearLoad : VehicleRequirement {
                    doc /* The landing gear shall carry the limit load of a landing at a descent rate of [TBD] m/s without detrimental deformation. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Structural sizing of the gear.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
            }
            requirement <'OPS-003'> vtolDef : VehicleRequirement {
                doc /* VTOL shall mean takeoff and landing with the nacelles at 90 deg and no ground roll, with conversion to cruise in flight. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Defines the term for the requirements below.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'OPS-011'> vtolPad : VehicleRequirement {
                    doc /* The vehicle shall take off and land vertically from a flat surface within a [TBD] m diameter circle. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Sets the VTOL area needed.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
                requirement <'OPS-012'> vtolWindLimit : VehicleRequirement {
                    doc /* VTOL takeoff and landing shall be possible in steady wind up to [TBD] kt and gusts up to [TBD] kt. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Environmental limit for the checklist.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
            requirement <'OPS-004'> cvtolDef : VehicleRequirement {
                doc /* C/VTOL shall mean a flight that includes transition between hover and cruise and that can take off in one of CTOL or VTOL and land in the other. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Defined by the program owner: transition, with takeoff and landing possible in alternate modes.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'OPS-013'> cvtolTransitionGround : VehicleRequirement {
                    doc /* In C/VTOL mode the flight controller shall accept the landing mode selection in flight and configure the nacelles to match. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Lets the pilot change mode in flight.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
            requirement <'OPS-014'> modeSelect : VehicleRequirement {
                doc /* The remote pilot shall select CTOL, STOL, VTOL or C/VTOL before takeoff. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Mode drives the checklist and limits.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
                requirement <'OPS-015'> modeDisplay : VehicleRequirement {
                    doc /* The ground station shall display the selected mode and the associated limits. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "The pilot must see what is selected.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
                requirement <'OPS-018'> modeLock : VehicleRequirement {
                    doc /* The flight controller shall not change the takeoff and landing selection during flight except as in OPS-013. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Prevents unplanned mode change.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
            requirement <'OPS-016'> modeChecklistLink : VehicleRequirement {
                doc /* The flight controller shall not arm until the preflight checklist for the selected mode is complete. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Enforces the preflight check.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
            }
            requirement <'OPS-017'> modeEnvelope : VehicleRequirement {
                doc /* The flight controller shall apply the envelope limits for the selected mode. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Speed and attitude limits differ by mode.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'OPS-019'> stolDef : VehicleRequirement {
                doc /* STOL shall mean takeoff and landing with the nacelles at a partially tilted angle between the CTOL and VTOL angles and a ground roll shorter than the CTOL ground roll. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Program owner added STOL: partial tilt shortens the roll and the thrust carries part of the weight.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'OPS-020'> stolAngleRange : VehicleRequirement {
                    doc /* The flight controller shall allow the remote pilot to select a STOL nacelle angle between [TBD] deg and [TBD] deg. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Range of partial tilt allowed for takeoff and landing.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
                requirement <'OPS-021'> stolTakeoffRoll : VehicleRequirement {
                    doc /* The takeoff ground roll in STOL mode shall not exceed [TBD] m on [TBD] surface at the maximum STOL takeoff mass. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Defines the short runway.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
                requirement <'OPS-022'> stolLandingRoll : VehicleRequirement {
                    doc /* The landing ground roll in STOL mode shall not exceed [TBD] m on [TBD] surface. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Defines the short runway.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
                requirement <'OPS-024'> stolRotorClear : VehicleRequirement {
                    doc /* The rotors shall clear the ground by at least [TBD] mm at every STOL nacelle angle and takeoff and landing attitude. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Partially tilted rotors sweep nearer the ground.";
                    attribute :>> phase = "PDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
                requirement <'OPS-025'> stolSchedule : VehicleRequirement {
                    doc /* The flight controller shall schedule nacelle angle with airspeed during the STOL ground roll and approach. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Tilt changes thrust direction as the wing takes the load.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
                requirement <'OPS-026'> stolSpeeds : VehicleRequirement {
                    doc /* The rotation speed and approach speed for STOL mode shall be determined by flight test and recorded in the flight manual. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Needed before STOL flights are made.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
                requirement <'OPS-027'> stolEnvelopeLimits : VehicleRequirement {
                    doc /* The flight controller shall apply the STOL envelope limits for speed, attitude and nacelle angle when STOL is selected. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Limits differ from CTOL and VTOL.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
        }
        requirement <'CHK-001'> preflightChecklist : VehicleRequirement {
            doc /* The program shall provide a preflight checklist for each of CTOL, STOL, VTOL and C/VTOL. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Each mode has different items.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
            requirement <'CHK-003'> chkTrace : VehicleRequirement {
                doc /* Every checklist item shall trace to a requirement or hazard it protects. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Keeps the checklist tied to the safety case.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'CHK-004'> chkElectronic : VehicleRequirement {
                doc /* The ground station shall present the checklist for the selected mode and record each item as complete. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Supports enforcement in OPS-016.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
                requirement <'CHK-005'> chkLog : VehicleRequirement {
                    doc /* The ground station shall store the completed checklist with the flight record. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "Evidence of the check.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
            }
            requirement <'CHK-006'> chkAutoItems : VehicleRequirement {
                doc /* The flight controller shall check automatically every preflight item that has a sensor and mark it complete or failed. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Reduces missed items.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'CHK-007'> chkPaper : VehicleRequirement {
                doc /* The program shall provide a printed form of each checklist. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Usable when the ground station is not working.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'CHK-008'> chkRevision : VehicleRequirement {
                doc /* Each checklist shall carry a revision identifier. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Prevents use of an old version.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'CHK-009'> chkRevDisplay : VehicleRequirement {
                    doc /* The ground station shall show the revision of the checklist in use. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "The user can see which revision is in use.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
        }
        requirement <'CHK-002'> postflightChecklist : VehicleRequirement {
            doc /* The program shall provide a postflight checklist for each of CTOL, STOL, VTOL and C/VTOL. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Each mode has different items.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
    }

    package ControlReqs {
        requirement <'FCS-001'> hoverControl : VehicleRequirement {
            doc /* The flight controller shall stabilize attitude in hover using differential rotor thrust and nacelle tilt. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "A twin rotor aircraft has no other hover control effectors besides tilt and thrust, unless surfaces are added.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'FCS-002'> hoverPitchAuth : VehicleRequirement {
                doc /* The control system shall produce a pitch moment of at least [TBD] N-m in hover at maximum takeoff weight. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sets effector sizing for pitch.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'FCS-003'> hoverRollAuth : VehicleRequirement {
                doc /* The control system shall produce a roll moment of at least [TBD] N-m in hover at maximum takeoff weight. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Roll comes from differential thrust.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'FCS-004'> hoverYawAuth : VehicleRequirement {
                doc /* The control system shall produce a yaw moment of at least [TBD] N-m in hover at maximum takeoff weight. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Yaw comes from differential nacelle tilt.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'FCS-005'> hoverAttitudeAccuracy : VehicleRequirement {
                doc /* The flight controller shall hold attitude within [TBD] deg in hover in steady wind up to the VTOL wind limit. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Tied to the wind limit in OPS-012.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FCS-006'> hoverBandwidth : VehicleRequirement {
                doc /* The attitude control loop in hover shall have a bandwidth of at least [TBD] rad/s. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Bandwidth must exceed the unstable pole of the airframe.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
                requirement <'FCS-007'> hoverGainMargin : VehicleRequirement {
                    doc /* The attitude loops in hover shall have a gain margin of at least [TBD] dB and a phase margin of at least [TBD] deg. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Robustness to model error.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
            }
            requirement <'FCS-026'> controlLatency : VehicleRequirement {
                doc /* The time from sensor sample to actuator command shall not exceed [TBD] ms. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Latency reduces phase margin.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FCS-027'> loopRate : VehicleRequirement {
                doc /* The attitude control loop shall run at a rate of at least [TBD] Hz. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sampling delay affects stability.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FCS-030'> stolControl : VehicleRequirement {
                doc /* The flight controller shall control attitude with the nacelles held at any angle in the STOL range. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "STOL flies with partial tilt for the whole takeoff and landing.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'FCS-008'> conversionControl : VehicleRequirement {
            doc /* The flight controller shall control attitude and altitude through the whole conversion corridor. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Conversion is the highest risk phase.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'FCS-009'> conversionMargins : VehicleRequirement {
                doc /* The attitude loops shall meet the margins of FCS-007 at every nacelle angle in the corridor. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Gain scheduling must keep margins across the transition.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'FCS-010'> gainSchedule : VehicleRequirement {
                doc /* The flight controller shall schedule control gains on nacelle angle and airspeed. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Plant dynamics change strongly with tilt angle.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'FCS-011'> conversionAltHold : VehicleRequirement {
                doc /* The flight controller shall keep altitude within [TBD] m during conversion. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Altitude loss in conversion is a safety hazard near the ground.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'FCS-012'> cruiseControl : VehicleRequirement {
            doc /* The flight controller shall stabilize attitude and airspeed in cruise using control surfaces and rotor thrust. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Control surfaces are assumed; confirm with the aerodynamics trade.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'FCS-013'> cruiseAirspeed : VehicleRequirement {
                doc /* The flight controller shall hold airspeed within [TBD] kt in cruise. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Airspeed hold needed for energy-efficient cruise.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'FCS-014'> modeManager : VehicleRequirement {
            doc /* The flight controller shall implement the FlightModes state definition and reject any transition not in it. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Implements VEH-7 in software.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'FCS-015'> modeStartup : VehicleRequirement {
                doc /* The flight controller shall start in the hover mode after power-up with the nacelles at the hover angle or after the nacelles are driven there. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "A known starting mode.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'FCS-016'> pilotModes : VehicleRequirement {
            doc /* The flight controller shall offer manual-attitude, assisted and automatic landing control modes to the remote pilot. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Different levels of pilot workload.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
            requirement <'FCS-017'> failsafeLink : VehicleRequirement {
                doc /* The flight controller shall command the return and land mode if the control link is lost for more than [TBD] s. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Link loss response is a Part 107 operating practice.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'FCS-018'> failsafeLand : VehicleRequirement {
                    doc /* The landing mode shall bring the aircraft to the ground in the selected landing mode. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Lands as planned.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
        }
        requirement <'FCS-019'> altitudeLimit : VehicleRequirement {
            doc /* The flight controller shall prevent altitude above 400 ft AGL. */
            attribute :>> basis = Basis::directive;
            attribute :>> rationale = "Part 107 altitude limit applied in software.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'FCS-020'> geofence : VehicleRequirement {
                doc /* The flight controller shall apply a geofence of [TBD] m horizontal radius around the takeoff point. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Keeps the aircraft within visual range.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'FCS-021'> losRange : VehicleRequirement {
            doc /* The flight controller shall warn the pilot when the aircraft nears the visual range limit of [TBD] m. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Visual line of sight depends on distance.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'FCS-022'> stateEstimate : VehicleRequirement {
            doc /* The flight controller shall estimate attitude, position, velocity and airspeed with the accuracies in the boundary variable table. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Estimates feed every control loop.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'FCS-023'> attitudeAccuracy : VehicleRequirement {
                doc /* The attitude estimate shall be accurate to within [TBD] deg. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sets control accuracy.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FCS-024'> airspeedSensing : VehicleRequirement {
                doc /* The aircraft shall measure airspeed using a sensor that works in hover and cruise. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Pitot-tube sensors do not work in hover.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FCS-025'> sensorRedundancy : VehicleRequirement {
                doc /* The flight controller shall use at least [TBD] independent sources for attitude. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Single sensor failure must not lose attitude.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'FCS-029'> sourceFailDetect : VehicleRequirement {
                    doc /* The flight controller shall detect a failed attitude source within [TBD] ms. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Needed to switch to the healthy source.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
        }
        requirement <'FCS-028'> saturation : VehicleRequirement {
            doc /* The flight controller shall prevent integrator windup when any effector is saturated. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Windup causes overshoot after saturation.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
    }

    package AeroReqs {
        requirement <'AER-001'> aeroModel : VehicleRequirement {
            doc /* The program shall maintain an aerodynamic model of the vehicle valid over the nacelle angle range of 0 to 90 deg and the full flight envelope. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "The control, stability and flutter work all use it.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'AER-002'> aeroModelSource : VehicleRequirement {
                doc /* The aerodynamic model shall be built from computational analysis and corrected with wind tunnel or flight test data. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Models must be tied to measurements.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'AER-003'> aeroUncertainty : VehicleRequirement {
                doc /* The aerodynamic model shall state an uncertainty for every coefficient used in control design. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Control margins need the uncertainty.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'AER-023'> stolAero : VehicleRequirement {
                doc /* The aerodynamic model shall be valid for the STOL angle range, including rotor wake on the wing and ground effect. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Partial tilt blows the wing, adding lift.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
                requirement <'AER-024'> stolPerformance : VehicleRequirement {
                    doc /* The STOL takeoff and landing distances shall be computed and recorded as [TBD] m. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Input to the STOL roll requirements.";
                    attribute :>> phase = "PDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
            }
        }
        requirement <'AER-004'> cruiseLD : VehicleRequirement {
            doc /* The vehicle lift-to-drag ratio at the cruise point shall be at least [TBD]. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Cruise efficiency drives endurance.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'AER-005'> wingArea : VehicleRequirement {
            doc /* The wing area shall be [TBD] m2. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sizes the stall speed and cruise efficiency.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
            requirement <'AER-006'> wingSpan : VehicleRequirement {
                doc /* The wing span shall be [TBD] m. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sets induced drag and storage.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'AER-007'> stallSpeed : VehicleRequirement {
                doc /* The stall speed at maximum takeoff weight shall not exceed [TBD] kt. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sets the CTOL speeds and the conversion corridor floor.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'AER-008'> corridorDefinition : VehicleRequirement {
            doc /* The conversion corridor shall be defined as the airspeed range allowed at each nacelle angle, recorded as [TBD]. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Open item VEH-4.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'AER-009'> corridorLower : VehicleRequirement {
                doc /* The lower corridor boundary shall be set by the wing stall margin of [TBD] percent. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Avoids wing stall during conversion.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'AER-010'> corridorUpper : VehicleRequirement {
                doc /* The upper corridor boundary shall be set by the rotor loading and flutter margin limits. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Fast flow at high tilt loads the rotor.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'AER-011'> wakeInteraction : VehicleRequirement {
            doc /* The program shall assess the rotor wake effect on the wing, tail and FPV camera in hover and conversion. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Rotor wash changes forces on the wing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'AER-012'> fountain : VehicleRequirement {
                doc /* The program shall assess the ground effect and recirculation in VTOL takeoff and landing. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Ground effect changes hover thrust and stability.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'AER-013'> tailSizing : VehicleRequirement {
            doc /* The tail and control surface sizes shall give a static margin within the limits of STB-009 at every nacelle angle. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Ties stability limits to sizing.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'AER-014'> trim : VehicleRequirement {
                doc /* The aircraft shall be trimmable in pitch at every nacelle angle within the corridor. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Out-of-trim conversion is unflyable.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'AER-015'> controlSurfaces : VehicleRequirement {
                doc /* Each control surface shall provide at least [TBD] of the control power needed for FCS-012. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Sizes the surfaces.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'AER-016'> ctolAero : VehicleRequirement {
            doc /* The vehicle shall meet its stall and takeoff requirements in CTOL mode with the nacelles at the CTOL angle. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "CTOL mode needs lift from the wing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'AER-017'> dragCount : VehicleRequirement {
            doc /* The program shall maintain a drag build-up for the vehicle with each supported payload sensor. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Sensors change the drag and the endurance.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'AER-018'> cruisePower : VehicleRequirement {
            doc /* The electrical power in cruise shall be computed and recorded as [TBD] W. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Input to the endurance constraint.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'AER-019'> hoverPower : VehicleRequirement {
            doc /* The electrical power in hover shall be computed and recorded as [TBD] W. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Input to the endurance constraint.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'AER-020'> conversionPower : VehicleRequirement {
                doc /* The electrical power in conversion shall be computed and recorded as [TBD] W. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Input to the endurance constraint.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'AER-021'> missionProfile : VehicleRequirement {
            doc /* The mission profile used for endurance shall be defined by hover, conversion and cruise durations of [TBD]. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Endurance depends on the time in each phase.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'AER-022'> windEnvelope : VehicleRequirement {
            doc /* The vehicle shall remain controllable in winds up to [TBD] kt in cruise. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets the wind limit for flight.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
    }

    package StructureReqs {
        requirement <'STR-001'> loadCases : VehicleRequirement {
            doc /* The program shall define the structural load cases for hover, conversion, cruise, gusts, landing and ground handling. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Strength is checked per case.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'STR-002'> limitFactor : VehicleRequirement {
                doc /* The limit load factors shall be [TBD] in the positive and [TBD] in the negative direction. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Open item: factors are not chosen.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'STR-003'> safetyFactor : VehicleRequirement {
            doc /* The ultimate factor of safety shall be [TBD] times limit load. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Open item: factor not chosen.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'STR-004'> marginReporting : VehicleRequirement {
                doc /* Every structural margin of safety shall be reported with the load case and failure mode. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Makes the margins traceable.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'STR-005'> wingStrength : VehicleRequirement {
            doc /* The wing and its attachment shall carry the limit loads without detrimental deformation and the ultimate loads without failure. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Primary lift structure.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-006'> nacelleStrength : VehicleRequirement {
            doc /* The nacelle support structure shall carry the limit and ultimate loads, including rotor thrust, torque and gyroscopic moments. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "The nacelle carries the rotor loads into the wing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-007'> fuselageStrength : VehicleRequirement {
            doc /* The fuselage shall carry the limit and ultimate loads, including battery and payload inertia loads. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Carries internal masses.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-008'> gimbalMount : VehicleRequirement {
            doc /* The gimbal mount shall carry the limit and ultimate loads with the heaviest supported sensor. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Sensor swaps change the load.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-009'> jointAllowables : VehicleRequirement {
            doc /* Joint and fastener allowables shall be based on test data or the material source recorded in the stress report. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Prevents unsupported allowables.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-010'> materialAllowables : VehicleRequirement {
            doc /* Material allowables shall be taken from a recorded source and a knockdown for [TBD]. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Composite allowables need knockdowns.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-011'> staticTest : VehicleRequirement {
            doc /* The structure shall be tested to limit load before first flight. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Verifies the analysis before flight.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'STR-012'> testToUltimate : VehicleRequirement {
                doc /* The structure test article shall be tested to ultimate load, or to a reduced level of [TBD] percent of ultimate if a full test is not practical. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Decision needed on the test depth.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'STR-013'> testInstrumentation : VehicleRequirement {
                doc /* The structural test shall record strain and deflection at [TBD] locations. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Checks the analysis against test.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'STR-014'> fatigue : VehicleRequirement {
            doc /* The primary structure shall have a fatigue life of at least [TBD] flight hours. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets the inspection interval.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STR-015'> vibration : VehicleRequirement {
            doc /* The structure shall have no resonance within [TBD] percent of the rotor harmonics. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Resonance causes fatigue and noise.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'STR-016'> groundVibTest : VehicleRequirement {
                doc /* A ground vibration test shall measure the natural frequencies and mode shapes of the assembled aircraft. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Verifies the analysis model for flutter.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'STR-017'> flutterMargin : VehicleRequirement {
            doc /* Whirl flutter margin shall be at least [TBD] percent on airspeed or rotor speed. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Adopted margin is open in the flutter program.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'STR-018'> flutterModel : VehicleRequirement {
                doc /* The flutter analysis model shall include the stiffness of the nacelle, tilt mechanism and wing, with the rotor and gyroscopic effects. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "These drive the whirl flutter mode.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'STR-019'> flutterModelUpdate : VehicleRequirement {
                doc /* The flutter analysis model shall be updated with the ground vibration test results before flight. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Test data corrects the model.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'STR-020'> flutterAllAngles : VehicleRequirement {
                doc /* The flutter analysis shall cover every nacelle tilt angle from 0 to 90 deg. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Stiffness and rotor axis change with tilt.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'STR-021'> flutterPayload : VehicleRequirement {
                doc /* The flutter analysis shall cover the lightest and heaviest supported payload sensor. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Payload changes nose mass and the modes.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'STR-026'> flutterPartialTilt : VehicleRequirement {
                doc /* The flutter analysis shall cover sustained operation at every nacelle angle in the STOL range, including the ground roll. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Partial tilt may be held for a long time, unlike conversion.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
        }
        requirement <'STR-022'> massBudget : VehicleRequirement {
            doc /* The program shall maintain a mass budget with a margin of [TBD] percent at PDR, reduced at later reviews. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Mass margin policy is open.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
            requirement <'STR-023'> massProperties : VehicleRequirement {
                doc /* The program shall record the mass, center of gravity and inertia of each component. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Input to the stability and control analyses.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
        }
        requirement <'STR-024'> impactLanding : VehicleRequirement {
            doc /* The structure shall withstand a landing at a descent rate of [TBD] m/s in VTOL mode without damage to the battery or sensor. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Hard landing is a likely event.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STR-025'> rotorStrike : VehicleRequirement {
            doc /* The structure shall limit the damage from a blade strike on the ground to a repairable level. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Probable event in early flight testing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
    }

    package AvionicsReqs {
        requirement <'AVN-001'> controlLink : VehicleRequirement {
            doc /* The aircraft shall have a control link between the ground station and the flight controller. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pilot control path.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'AVN-002'> linkRange : VehicleRequirement {
                doc /* The control link shall operate at a range of at least [TBD] m with the margin of [TBD] dB. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Must cover the visual line of sight range.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'AVN-003'> linkLatency : VehicleRequirement {
                doc /* The control link latency shall not exceed [TBD] ms. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Latency limits manual control.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'AVN-004'> linkFrequency : VehicleRequirement {
                doc /* The control link shall operate on a frequency band permitted for unlicensed use in the area of operation. */
                attribute :>> basis = Basis::directive;
                attribute :>> rationale = "Operating on a legal band is required.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'AVN-005'> linkEncryption : VehicleRequirement {
                doc /* The control link shall authenticate commands so that only the paired ground station can control the aircraft. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Prevents accidental or hostile control.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'AVN-006'> linkLossDetect : VehicleRequirement {
                doc /* The flight controller shall detect control link loss within [TBD] ms. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Starts the failsafe in FCS-017.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'AVN-007'> telemetryDown : VehicleRequirement {
                doc /* The aircraft shall send telemetry to the ground station at a rate of at least [TBD] Hz. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Supports the displays.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'AVN-008'> gps : VehicleRequirement {
            doc /* The aircraft shall have a satellite navigation receiver that reports position to the flight controller. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Position and geofence.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'AVN-009'> gpsAccuracy : VehicleRequirement {
                doc /* The satellite navigation position shall be accurate to within [TBD] m. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Geofence and landing accuracy.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'AVN-010'> gpsLoss : VehicleRequirement {
                doc /* The flight controller shall continue attitude control when the satellite navigation is lost. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Attitude control must not depend on GPS.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'AVN-026'> gpsLossAlert : VehicleRequirement {
                    doc /* The flight controller shall alert the remote pilot within [TBD] s of satellite navigation loss. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "The pilot must know navigation is lost.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
        }
        requirement <'AVN-011'> imu : VehicleRequirement {
            doc /* The aircraft shall have an inertial measurement unit with a gyro range of at least [TBD] deg/s and an accelerometer range of at least [TBD] g. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets attitude estimation capability.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'AVN-012'> imuVibration : VehicleRequirement {
                doc /* The inertial measurement unit shall be mounted with vibration isolation that gives noise below [TBD] at rotor harmonics. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Rotor vibration corrupts the sensor.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'AVN-013'> magnetometer : VehicleRequirement {
            doc /* The aircraft shall measure heading. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Heading for navigation and landing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'AVN-027'> magInterference : VehicleRequirement {
                doc /* The heading measurement shall stay accurate to within [TBD] deg with the motors at full power. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Motors disturb magnetometers.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'AVN-014'> baro : VehicleRequirement {
            doc /* The aircraft shall have a barometric altitude sensor protected from rotor wash. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Altitude estimation.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'AVN-015'> altitudeAgl : VehicleRequirement {
            doc /* The aircraft shall measure height above ground to within [TBD] m below [TBD] m altitude. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Needed for VTOL landing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'AVN-016'> watchdog : VehicleRequirement {
            doc /* The flight controller shall have a watchdog that resets the processor and returns to a safe state within [TBD] ms of a software hang. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Hang recovery.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'AVN-017'> killSwitch : VehicleRequirement {
            doc /* The remote pilot shall be able to stop all motors from the ground station in at most [TBD] s. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Emergency stop on the ground.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
            requirement <'AVN-018'> killInFlight : VehicleRequirement {
                doc /* The motor stop in flight shall require a deliberate action by the pilot. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "A stray press must not drop the aircraft.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byDemonstration;
            }
        }
        requirement <'AVN-019'> remoteId : VehicleRequirement {
            doc /* The aircraft shall broadcast remote identification where required by the rules of the area of operation. */
            attribute :>> basis = Basis::directive;
            attribute :>> rationale = "FAA remote ID rule for unmanned aircraft.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'AVN-020'> antiCollision : VehicleRequirement {
            doc /* The aircraft shall carry lights visible for [TBD] statute miles if operated at night. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Part 107 night operation rule if used.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'AVN-021'> dataLogger : VehicleRequirement {
            doc /* The aircraft shall log flight data at a rate of at least [TBD] Hz for the whole flight. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Needed for review and model correction.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'AVN-022'> logStorage : VehicleRequirement {
                doc /* The data logger shall hold at least [TBD] hours of data and keep it after a power loss. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Crash data must survive.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'AVN-023'> avionicsMass : VehicleRequirement {
            doc /* The avionics shall have a total mass of not more than [TBD] kg. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Part of the mass budget.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'AVN-024'> avionicsPower : VehicleRequirement {
            doc /* The avionics shall draw no more than [TBD] W on average. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Part of the power budget.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'AVN-025'> emc : VehicleRequirement {
            doc /* The avionics shall tolerate the electromagnetic emissions of the motors and speed controllers during operation. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Motor noise upsets sensors.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
    }

    package SoftwareReqs {
        requirement <'SWR-001'> softwareStandard : VehicleRequirement {
            doc /* The flight software shall be developed according to a recorded process that defines requirements, design, review, test and configuration control. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Even small projects need a process; the level of rigor is a decision (AR-08/32 and the software plan).";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
            requirement <'SWR-002'> softwareLevel : VehicleRequirement {
                doc /* The program shall assign a development assurance level to the flight software and record the reason. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Level not yet assigned.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'SWR-003'> softwareReq : VehicleRequirement {
                doc /* Each software requirement shall trace to a vehicle requirement and to at least one test. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Traceability to tests.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'SWR-004'> codeReview : VehicleRequirement {
                doc /* All flight software changes shall be reviewed by a person other than the author before release. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Catches defects.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'SWR-005'> staticAnalysis : VehicleRequirement {
                doc /* The flight software shall pass static analysis with no open high-severity findings at release. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Finds defect classes.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byAnalysis;
            }
            requirement <'SWR-006'> unitTest : VehicleRequirement {
                doc /* Each flight software function that affects control or mode logic shall have a unit test. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Tests the logic directly.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'SWR-007'> hil : VehicleRequirement {
                doc /* The flight software shall pass a hardware-in-the-loop test of every mode transition before first flight. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Tests the real hardware path.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'SWR-008'> simulation : VehicleRequirement {
                    doc /* A simulation with the aerodynamic model shall test each mode transition and each failure response. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Cheaper than flight tests.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byAnalysis;
                }
            }
            requirement <'SWR-009'> buildControl : VehicleRequirement {
                doc /* Each flight software build shall carry a version identifier and a hash that the ground station displays. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Know what is flying.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'SWR-010'> buildMatch : VehicleRequirement {
                    doc /* The preflight checklist shall confirm the software version matches the approved release. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "Prevents the wrong version.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
            }
            requirement <'SWR-011'> parameters : VehicleRequirement {
                doc /* Flight parameters shall be stored with a checksum. */
                attribute :>> basis = Basis::projectChoice;
                attribute :>> rationale = "Detects corrupt parameters.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'SWR-012'> parameterRecord : VehicleRequirement {
                    doc /* The parameter set used shall be recorded in the flight log. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "Reproducibility.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
                requirement <'SWR-023'> parameterGate : VehicleRequirement {
                    doc /* The flight controller shall refuse to arm with an invalid parameter checksum. */
                    attribute :>> basis = Basis::projectChoice;
                    attribute :>> rationale = "Stops a flight with corrupt parameters.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byTest;
                }
            }
            requirement <'SWR-021'> regression : VehicleRequirement {
                doc /* The test suite shall run after each software change. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Prevents regressions.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'SWR-024'> regressionGate : VehicleRequirement {
                    doc /* The test suite shall pass before a flight software release. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "Release gate.";
                    attribute :>> phase = "CDR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
            }
            requirement <'SWR-022'> dataLink : VehicleRequirement {
                doc /* The ground station software shall be developed under the same process as the flight software or a recorded equivalent. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Ground station errors can mislead the pilot.";
                attribute :>> phase = "PDR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
        }
        requirement <'SWR-013'> timing : VehicleRequirement {
