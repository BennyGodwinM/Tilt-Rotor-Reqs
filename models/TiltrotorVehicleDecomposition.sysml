        }
        requirement <'TLT-020'> tiltCalibrate : VehicleRequirement {
            doc /* The flight controller shall verify nacelle angle against known end stop positions during preflight checks. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Catches sensor drift or slippage.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'TLT-021'> tiltLife : VehicleRequirement {
            doc /* The tilt mechanism shall complete at least [TBD] conversion cycles without maintenance. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets maintenance interval and testing wear.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'TLT-022'> conversionSchedule : VehicleRequirement {
            doc /* The flight controller shall schedule nacelle angle as a function of airspeed within the conversion corridor, to be defined. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Corridor definition is still open (VEH-4).";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'TLT-023'> conversionAbort : VehicleRequirement {
            doc /* The flight controller shall return the nacelles to the hover position when the conversion leaves the corridor. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Hover is the known safe state.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
    }

    package PayloadReqs {
        requirement <'PLD-001'> payloadSensor : VehicleRequirement {
            doc /* The nose gimbal shall carry one payload sensor that is replaceable by the operator without modifying the airframe or gimbal. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Replaces the fixed GoPro in VEH-1 with a swappable sensor; the GoPro becomes one supported payload.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'PLD-002'> mechInterface : VehicleRequirement {
            doc /* The gimbal payload interface shall define one mounting pattern, with dimensions and fastener type of [TBD], for every supported sensor. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "A single mount is what makes sensors swappable.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'PLD-003'> swapTime : VehicleRequirement {
            doc /* A trained operator shall exchange the payload sensor in no more than [TBD] minutes using only the tools listed in the maintenance manual. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Swaps must be quick enough for field use.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'PLD-004'> elecInterface : VehicleRequirement {
            doc /* The gimbal payload interface shall provide regulated power at [TBD] V and no more than [TBD] W to the sensor. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sensors differ in supply needs; the limit protects the avionics bus.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-005'> dataInterface : VehicleRequirement {
            doc /* The gimbal payload interface shall provide a data connection of type [TBD] with a minimum throughput of [TBD] Mbit/s. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Higher-rate sensors need a defined data path.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-006'> sensorDetect : VehicleRequirement {
            doc /* The flight controller shall identify the installed sensor type within [TBD] s of power-up. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Mass, size and settings depend on which sensor is fitted.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-007'> sensorProfile : VehicleRequirement {
            doc /* The flight controller shall load a stored profile for the identified sensor containing its mass, center of gravity offset and power draw. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Static margin and endurance estimates depend on the sensor.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'PLD-008'> unknownSensor : VehicleRequirement {
            doc /* The flight controller shall block takeoff when the installed sensor has no stored profile and no manual mass entry. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Unknown mass makes the static margin estimate unreliable.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'PLD-009'> maxMass : VehicleRequirement {
            doc /* The gimbal shall support a payload sensor of mass up to [TBD] kg. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets the gimbal and mount design load.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-010'> maxEnvelope : VehicleRequirement {
            doc /* The gimbal shall support a payload sensor within an envelope of [TBD] mm by [TBD] mm by [TBD] mm. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets nose clearance and gimbal rotation space.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'PLD-011'> massRange : VehicleRequirement {
            doc /* The gimbal control shall tune to any sensor mass within the range in PLD-009 using the stored profile. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Pointing quality changes with payload inertia.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-012'> payloadMassBudget : VehicleRequirement {
            doc /* The takeoff mass requirement shall be met with the heaviest supported payload sensor. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Part 107 mass limit applies for any sensor.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-013'> gimbalAxes : VehicleRequirement {
            doc /* The gimbal shall point the payload sensor in pitch over at least [TBD] deg and in yaw over at least [TBD] deg. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Pointing range defines the field of regard.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-014'> gimbalAccuracy : VehicleRequirement {
            doc /* The gimbal shall hold the commanded pointing angle within [TBD] deg during hover and cruise. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Pointing error degrades sensor data.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-015'> gimbalStabilize : VehicleRequirement {
            doc /* The gimbal shall isolate the sensor from aircraft angular motion to within [TBD] deg rms. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Image quality needs stabilization.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-016'> gimbalClear : VehicleRequirement {
            doc /* The gimbal and sensor shall not contact the rotors, airframe or ground in any gimbal position or any tilt position. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Prevents strikes during rotation and landing.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'PLD-017'> gimbalPower : VehicleRequirement {
            doc /* The gimbal and payload sensor together shall draw no more than [TBD] W averaged over the mission. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Payload power reduces endurance.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'PLD-018'> gimbalCommandBoundary : VehicleRequirement {
            doc /* The gimbal yaw command shall be added to the boundary variables with a unit, range, latency and tolerance. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Closes the gimbal in the boundary definition of VEH-8.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'PLD-019'> payloadFault : VehicleRequirement {
            doc /* The flight controller shall continue flight when the payload sensor or gimbal fails. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Payload loss must not endanger the aircraft.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'PLD-020'> payloadRetain : VehicleRequirement {
            doc /* The sensor mount shall retain the sensor in all flight and landing load cases of the strength requirements. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "A released sensor is a hazard to people on the ground.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'PLD-021'> payloadRecord : VehicleRequirement {
            doc /* The aircraft shall record the sensor identifier in the flight log for each flight. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Links data to the sensor used.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'PLD-022'> payloadList : VehicleRequirement {
            doc /* The program shall maintain a list of supported sensors, each with a completed profile and a verification record. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Each supported sensor must have been checked for mass and clearance.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'FPV-001'> fpvCamera : VehicleRequirement {
            doc /* The vehicle shall carry a forward-looking FPV camera, separate from the payload sensor, that provides live video to the remote pilot. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pilot situational awareness, independent of what payload is fitted.";
            attribute :>> phase = "SIR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'FPV-002'> fpvFov : VehicleRequirement {
            doc /* The FPV camera shall have a horizontal field of view of at least [TBD] deg. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Pilot needs enough view to fly the aircraft.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'FPV-003'> fpvLatency : VehicleRequirement {
            doc /* The end-to-end FPV video latency from camera to pilot display shall not exceed [TBD] ms. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Latency limits how well the pilot can control by FPV.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'FPV-004'> fpvResolution : VehicleRequirement {
            doc /* The FPV video shall have a resolution of at least [TBD] by [TBD] pixels at [TBD] frames per second. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets image quality for the pilot.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'FPV-005'> fpvView : VehicleRequirement {
            doc /* The FPV camera shall be mounted so that the nacelles, rotors and gimbal do not block more than [TBD] percent of its field of view. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "The aircraft must not hide the view ahead.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'FPV-006'> fpvDownlink : VehicleRequirement {
            doc /* The video link shall operate at the range of the visual line of sight limit with the margin of [TBD] dB. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Loss of video at the range limit is unacceptable.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'FPV-007'> fpvNotSubstitute : VehicleRequirement {
            doc /* The remote pilot shall maintain visual line of sight with the aircraft while FPV video is in use. */
            attribute :>> basis = Basis::directive;
            attribute :>> rationale = "FPV does not replace visual line of sight under Part 107; a visual observer or the pilot's own sight remains required.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'FPV-008'> fpvPower : VehicleRequirement {
            doc /* The FPV camera and transmitter shall draw no more than [TBD] W. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Part of the avionics power budget.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'FPV-009'> fpvOverlay : VehicleRequirement {
            doc /* The video display shall overlay airspeed, altitude, remaining energy, nacelle angle and static margin status. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Lets the pilot see key data while flying FPV.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'FPV-010'> fpvLoss : VehicleRequirement {
            doc /* The flight controller shall indicate loss of the video link to the pilot within [TBD] s. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "The pilot must know when video is gone.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
    }

    package StabilityReqs {
        requirement <'STB-001'> staticMarginEstimate : VehicleRequirement {
            doc /* The flight controller shall estimate the longitudinal static margin, expressed as a fraction of mean aerodynamic chord, before takeoff and during flight. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pitch stability depends on center of gravity and neutral point, both of which change with payload and tilt.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-002'> cgEstimate : VehicleRequirement {
            doc /* The flight controller shall estimate the aircraft center of gravity from the stored component masses and positions, including the battery position and the installed sensor profile. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Payload swaps and battery position move the center of gravity.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STB-003'> cgAccuracy : VehicleRequirement {
            doc /* The center of gravity estimate shall be accurate to within [TBD] percent of mean aerodynamic chord. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Estimate error is a direct error in static margin.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-004'> batteryPosition : VehicleRequirement {
            doc /* The aircraft shall detect the battery position in its tray, or the operator shall record it before flight, and the result shall be used in the estimate. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Battery is the largest movable mass.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'STB-005'> neutralPoint : VehicleRequirement {
            doc /* The flight controller shall estimate the neutral point from an aerodynamic model scheduled with nacelle tilt angle and airspeed. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Tilting rotors change the neutral point strongly during conversion.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STB-006'> neutralPointAccuracy : VehicleRequirement {
            doc /* The neutral point estimate shall be accurate to within [TBD] percent of mean aerodynamic chord. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Estimate error is a direct error in static margin.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-007'> smInflight : VehicleRequirement {
            doc /* The flight controller shall refine the static margin estimate in flight from measured trim and pitch response. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Checks the model against the real aircraft.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-008'> smUpdate : VehicleRequirement {
            doc /* The static margin estimate shall be updated at least every [TBD] s during flight. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Static margin changes during conversion.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-009'> smLimits : VehicleRequirement {
            doc /* The minimum and maximum acceptable static margins shall be defined for the hover, conversion and cruise modes as [TBD]. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Warnings need defined thresholds.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'STB-010'> smWarnPre : VehicleRequirement {
            doc /* The flight controller shall inhibit takeoff when the estimated static margin is outside the limits of STB-009 for the planned configuration. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Prevents flying an unstable aircraft.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'STB-011'> smWarnCaution : VehicleRequirement {
            doc /* The flight controller shall give the remote pilot a caution when the estimated static margin comes within [TBD] of a limit. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Early warning before the limit is reached.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'STB-012'> smWarnAlert : VehicleRequirement {
            doc /* The flight controller shall give the remote pilot an alert within [TBD] s when the estimated static margin is outside a limit in flight. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "The pilot needs time to react.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'STB-013'> smAlertAction : VehicleRequirement {
            doc /* The flight controller shall command the landing mode when an alert persists for more than [TBD] s. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Gives the pilot time to act first, then lands.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'STB-014'> smConfidence : VehicleRequirement {
            doc /* The flight controller shall report a confidence level with each static margin estimate and shall treat a low confidence as a caution. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "A poor estimate must not look like a good one.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-015'> smConfirmBalance : VehicleRequirement {
            doc /* The operator shall be able to confirm the estimate by a balance check on the ground, and the aircraft shall accept the measured center of gravity as an input. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Ground check catches errors in stored masses.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'STB-016'> smRecord : VehicleRequirement {
            doc /* The aircraft shall log the static margin estimate, its confidence and its inputs throughout every flight. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Supports review and model correction.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'STB-017'> smFlightTest : VehicleRequirement {
            doc /* The static margin estimate shall be compared with flight test results at [TBD] configurations before release. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Validates the estimator.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'STB-018'> smRateDisplay : VehicleRequirement {
            doc /* The ground station shall display static margin, its limits and its confidence to the remote pilot. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "The pilot needs to see the number.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
    }

    package OperationsReqs {
        requirement <'OPS-001'> opModes : VehicleRequirement {
            doc /* The vehicle shall operate in three takeoff and landing modes: CTOL, VTOL and C/VTOL. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pilot choice of mode per flight.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-002'> ctolDef : VehicleRequirement {
            doc /* CTOL shall mean takeoff and landing with the nacelles at a fixed forward angle of [TBD] deg and a ground roll. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Defines the term for the requirements below.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'OPS-003'> vtolDef : VehicleRequirement {
            doc /* VTOL shall mean takeoff and landing with the nacelles at 90 deg and no ground roll, with conversion to cruise in flight. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Defines the term for the requirements below.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'OPS-004'> cvtolDef : VehicleRequirement {
            doc /* C/VTOL shall mean a flight that takes off in one of CTOL or VTOL and lands in the other. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Defines the mixed mode; confirm the intent with the program owner.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'OPS-005'> ctolGear : VehicleRequirement {
            doc /* The vehicle shall have landing gear or skids that support the aircraft on the ground in CTOL mode. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "The present architecture has no gear; this is a design decision to confirm.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'OPS-006'> ctolRunway : VehicleRequirement {
            doc /* The takeoff ground roll in CTOL mode shall not exceed [TBD] m on [TBD] surface. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets the runway the operator needs.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'OPS-007'> ctolLandingRoll : VehicleRequirement {
            doc /* The landing ground roll in CTOL mode shall not exceed [TBD] m on [TBD] surface. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets the runway the operator needs.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'OPS-008'> ctolClear : VehicleRequirement {
            doc /* The rotors shall clear the ground by at least [TBD] mm in CTOL takeoff and landing attitudes. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Strike risk on rotation and flare.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'OPS-009'> ctolSpeeds : VehicleRequirement {
            doc /* The rotation speed and approach speed for CTOL mode shall be determined by flight test and recorded in the flight manual. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Needed before CTOL flights are made.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'OPS-010'> ctolGearLoad : VehicleRequirement {
            doc /* The landing gear shall carry the limit load of a landing at a descent rate of [TBD] m/s without detrimental deformation. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Structural sizing of the gear.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'OPS-011'> vtolPad : VehicleRequirement {
            doc /* The vehicle shall take off and land vertically from a flat surface within a [TBD] m diameter circle. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets the VTOL area needed.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-012'> vtolWindLimit : VehicleRequirement {
            doc /* VTOL takeoff and landing shall be possible in steady wind up to [TBD] kt and gusts up to [TBD] kt. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Environmental limit for the checklist.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-013'> cvtolTransitionGround : VehicleRequirement {
            doc /* In C/VTOL mode the flight controller shall accept the landing mode selection in flight and configure the nacelles to match. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Lets the pilot change mode in flight.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-014'> modeSelect : VehicleRequirement {
            doc /* The remote pilot shall select CTOL, VTOL or C/VTOL before takeoff, and the flight controller shall not change the selection during the flight except as in OPS-013. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Mode drives the checklist and limits.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-015'> modeDisplay : VehicleRequirement {
            doc /* The ground station shall display the selected mode and the associated limits. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "The pilot must see what is selected.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-016'> modeChecklistLink : VehicleRequirement {
            doc /* The flight controller shall not arm until the preflight checklist for the selected mode is complete. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Enforces the preflight check.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'OPS-017'> modeEnvelope : VehicleRequirement {
            doc /* The flight controller shall apply the envelope limits for the selected mode. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Speed and attitude limits differ by mode.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'CHK-001'> preflightChecklist : VehicleRequirement {
            doc /* The program shall provide a preflight checklist for each of CTOL, VTOL and C/VTOL. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Each mode has different items.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'CHK-002'> postflightChecklist : VehicleRequirement {
            doc /* The program shall provide a postflight checklist for each of CTOL, VTOL and C/VTOL. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Each mode has different items.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'CHK-003'> chkTrace : VehicleRequirement {
            doc /* Every checklist item shall trace to a requirement or hazard it protects. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Keeps the checklist tied to the safety case.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'CHK-004'> chkElectronic : VehicleRequirement {
            doc /* The ground station shall present the checklist for the selected mode and record each item as complete. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Supports enforcement in OPS-016.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'CHK-005'> chkLog : VehicleRequirement {
            doc /* The ground station shall store the completed checklist with the flight record. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Evidence of the check.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'CHK-006'> chkAutoItems : VehicleRequirement {
            doc /* The flight controller shall check automatically every preflight item that has a sensor and mark it complete or failed. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Reduces missed items.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'CHK-007'> chkPaper : VehicleRequirement {
            doc /* The program shall provide a printed form of each checklist. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Usable when the ground station is not working.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'CHK-008'> chkRevision : VehicleRequirement {
            doc /* Each checklist shall carry a revision identifier, and the ground station shall show the revision in use. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Prevents use of an old version.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
    }

