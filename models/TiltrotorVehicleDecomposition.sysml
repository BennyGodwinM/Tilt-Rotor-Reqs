        requirement <'FLT-032'> conversionStall : VehicleRequirement {
            doc /* The flight controller shall return the nacelles to the hover position if the airspeed falls below the corridor floor in conversion. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Stall in conversion needs hover thrust.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'FLT-033'> conversionOverspeed : VehicleRequirement {
            doc /* The flight controller shall limit airspeed to the corridor ceiling during conversion. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Overspeed at high tilt is a rotor and flutter hazard.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'FLT-034'> rotorBreak : VehicleRequirement {
            doc /* The structure shall contain the loss of one rotor blade without damage to the battery or flight controller. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Blade loss is rare but dangerous.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'FLT-035'> batteryFire : VehicleRequirement {
            doc /* The aircraft shall keep a battery fire from reaching the flight controller and payload for at least [TBD] s. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Time to land.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'FLT-039'> sensorFailAlert : VehicleRequirement {
            doc /* The flight controller shall alert the pilot when the payload sensor fails. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Pilot awareness.";
            attribute :>> phase = "CDR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
    }

    package EnvironmentReqs {
        requirement <'ENV-001'> operatingTemp : VehicleRequirement {
            doc /* The vehicle shall operate with ambient temperatures from [TBD] to [TBD] degC. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Sets battery and electronics limits.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
            requirement <'ENV-002'> batteryTempLimits : VehicleRequirement {
                doc /* The battery shall be used only between [TBD] and [TBD] degC pack temperature. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Cold batteries lose capacity.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
        }
        requirement <'ENV-003'> storageTemp : VehicleRequirement {
            doc /* The vehicle shall survive storage between [TBD] and [TBD] degC without damage. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Vehicle stored in a car or hangar.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'ENV-004'> rainLimit : VehicleRequirement {
            doc /* The vehicle shall not be flown in rain unless demonstrated for it. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Electronics are unprotected.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'ENV-005'> altitudeDensity : VehicleRequirement {
            doc /* The vehicle shall meet its performance requirements up to a density altitude of [TBD] m. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Hover thrust falls with density.";
            attribute :>> phase = "PDR";
            attribute :>> verifyBy = VerificationMethod::byAnalysis;
        }
        requirement <'ENV-006'> icing : VehicleRequirement {
            doc /* The vehicle shall not be flown in conditions that produce icing. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Icing is out of scope.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'ENV-007'> gustLimit : VehicleRequirement {
            doc /* The vehicle shall be flown only in gusts below [TBD] kt. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Operating limit.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byDemonstration;
        }
        requirement <'ENV-008'> lightLevel : VehicleRequirement {
            doc /* The vehicle shall be flown only in daylight unless night operation is added and the lights of AVN-020 are fitted. */
            attribute :>> basis = Basis::projectChoice;
            attribute :>> rationale = "Part 107 night rule.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'ENV-009'> vibrationTransport : VehicleRequirement {
            doc /* The vehicle in its transport case shall survive [TBD] g shock and [TBD] vibration profile without damage. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Transport is a damage source.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'ENV-010'> dustSand : VehicleRequirement {
            doc /* The vehicle shall have protection of [TBD] against dust at the motors and tilt mechanism. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Grit wears bearings.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'ENV-011'> emcExternal : VehicleRequirement {
            doc /* The vehicle shall operate within the electromagnetic environment of [TBD]. */
            attribute :>> basis = Basis::placeholder;
            attribute :>> rationale = "Interference from other radios.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byTest;
        }
        requirement <'ENV-012'> birdStrike : VehicleRequirement {
            doc /* The vehicle structure shall be inspected after any bird or object strike. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Hidden damage.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
        }
        requirement <'MNT-001'> maintenanceManual : VehicleRequirement {
            doc /* The program shall maintain a maintenance manual with inspection, repair and parts replacement procedures. */
            attribute :>> basis = Basis::adoptedDefault;
            attribute :>> rationale = "Needed for continued safe flight.";
            attribute :>> phase = "ORR";
            attribute :>> verifyBy = VerificationMethod::byInspection;
            requirement <'MNT-002'> inspectionIntervals : VehicleRequirement {
                doc /* The maintenance manual shall state an inspection interval for each life-limited or wear item. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Items wear out.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'MNT-003'> lifeLimited : VehicleRequirement {
                    doc /* The program shall list every life-limited part with its limit in flight hours or cycles. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Blades, bearings, batteries and the tilt mechanism wear.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
            }
            requirement <'MNT-004'> accessPanels : VehicleRequirement {
                doc /* Every item inspected before flight shall be reachable without removing the wings or rotors. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Quick turnaround.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'MNT-005'> torqueMarks : VehicleRequirement {
                doc /* Every critical fastener shall carry a witness mark that shows loosening. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Visual check of fasteners.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'MNT-006'> spares : VehicleRequirement {
                doc /* The program shall maintain a list of spare parts needed to repair the most likely damage within [TBD] hours. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Flight test needs quick repair.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'MNT-007'> configLog : VehicleRequirement {
                doc /* The program shall record the configuration of each flight including the sensor, battery, software version and parameters. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Reproduces test conditions.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'MNT-008'> damageReport : VehicleRequirement {
                doc /* Every damage event shall be recorded and its effect on airworthiness assessed before the next flight. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Prevents flying with hidden damage.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
            }
            requirement <'MNT-009'> packaging : VehicleRequirement {
                doc /* The vehicle shall be transportable in a case of [TBD] by [TBD] by [TBD] mm. */
                attribute :>> basis = Basis::placeholder;
                attribute :>> rationale = "Field transport.";
                attribute :>> phase = "SIR";
                attribute :>> verifyBy = VerificationMethod::byInspection;
                requirement <'MNT-010'> assemblyTime : VehicleRequirement {
                    doc /* A trained operator shall assemble the vehicle from its case in at most [TBD] minutes. */
                    attribute :>> basis = Basis::placeholder;
                    attribute :>> rationale = "Field use.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byDemonstration;
                }
                requirement <'MNT-011'> assemblyKeying : VehicleRequirement {
                    doc /* Parts that can be assembled in more than one way shall be keyed so that only the right one fits. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "Assembly errors.";
                    attribute :>> phase = "SIR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
            }
            requirement <'MNT-012'> calibrations : VehicleRequirement {
                doc /* The program shall define the calibrations for the inertial sensors, nacelle sensors and gimbal. */
                attribute :>> basis = Basis::adoptedDefault;
                attribute :>> rationale = "Calibration drift.";
                attribute :>> phase = "ORR";
                attribute :>> verifyBy = VerificationMethod::byTest;
                requirement <'MNT-013'> calibrationRecord : VehicleRequirement {
                    doc /* The program shall record the result of each calibration. */
                    attribute :>> basis = Basis::adoptedDefault;
                    attribute :>> rationale = "Evidence of calibration.";
                    attribute :>> phase = "ORR";
                    attribute :>> verifyBy = VerificationMethod::byInspection;
                }
            }
        }
    }

