                attribute :>> rationale = "Symmetric with the left side.";
                attribute :>> phase = "CDR";
                attribute :>> verifyBy = VerificationMethod::byTest;
            }
            requirement <'FLT-012'> stuckNacelleResponse : VehicleRequirement {
                doc /* The flight controller shall hold the other nacelle at the angle that gives the least asymmetry. */
